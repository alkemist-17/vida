//
// Script: A.vida
// A is a utility library for Arrays.
// Version 1.0.0
//



// Library object
var lib = {}
var arrayType = [].type()



// Map 
lib.map = fun A, f {
    var R = newArray(A.len())
    for i, v in A {
        R[i] = f(v)
    }
    ret R
}



// Filter
lib.filter = fun A, pred {
    var R = []
    for _, v in A {
        if pred(v) {
            R.append(v)
        }
    }
    ret R
}



// Exclude
lib.exclude = fun A, pred {
    var R = []
    for _, v in A {
        if not pred(v) {
            R.append(v)
        }
    }
    ret R
}



// All
lib.all = fun A, pred {
    for _, v in A {
        if not pred(v) {
            ret false
        }
    }
    ret true
}



// Any
lib.any = fun A, pred {
    for _, v in A {
        if pred(v) {
            ret true
        }
    }
    ret false
}



// Reduce
lib.reduce = fun A, f, init {
    for _, v in A {
        init = f(init, v)
    }
    ret init
}



// TakeWhile
lib.takeWhile = fun A, pred {
    var R = []
    for _, v in A {
        if not pred(v) {
            ret R
        }
        R.append(v)
    }
    ret R
}



// Zip
lib.zip = fun l, r {
    var length = nil
    var ll = l.len()
    var lr = r.len()
    if ll < lr {
        length = ll
    } else {
        length = lr
    }
    var R = newArray(length)
    for i in length {
        R[i] = [l[i], r[i]]
    }
    ret R
}



// UnZip
lib.unzip = fun zipped {
    var l = zipped.len()
    var A = newArray(l)
    var B = newArray(l)
    for i, v in zipped {
        A[i] = v[0]
        B[i] = v[1]
    }
    ret [A, B]
}



// Drop
lib.drop = fun A, n {
    if n <= 0 {
        ret A
    }
    ret A[n..]
}



// Chunk
lib.chunk = fun A, size {
	var R = []
	var N = []
	for i in A.len() {
		if (i + 1) % size == 0 {
			R.append(N.append(A[i]))
			N = []
			continue
		}
		N.append(A[i])
	}
	if N.len() > 0 {
		R.append(N)
	}
	ret R
}



// First
lib.first = fun A {
    if A.len() == 0 {
        ret nil
    }
    ret A[0]
}



// First N
lib.firstN = fun A, n {
    if A.len() == 0 {
        ret nil
    }
    if n <= 0 {
        ret nil
    }
    ret A[..n]
}



// Last
lib.last = fun A {
    if A.len() == 0 {
        ret nil
    }
    ret A[-1]
}



// Tail
lib.tail = fun A {
    if A.len() == 0 {
        ret nil
    }
    ret A[1..]
}



// Head
lib.head = lib.first



// Init
lib.init = fun A {
    if A.len() == 0 {
        ret nil
    }
    ret A[0..-1]
}



// Exclude Nil
lib.excludeNil = fun A {
	var R = []
	for _, v in A {
		if v != nil {
			R.append(v)
		}
	}
	ret R
}



// Exclude Falsy
lib.excludeNil = fun A {
	var R = []
	for _, v in A {
		if v {
			R.append(v)
		}
	}
	ret R
}


// Compact
lib.compact = fun A {
	var R = []
	for _, v in A {
		if v {
			R.append(v)
		}
	}
	ret R
}



// IsArray
lib.isArray = fun A -> A.type() == arrayType



// IsEmpty
lib.isEmpty = fun A -> A.isEmpty()







// Export the library
export lib


